<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- TOP SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ICON -->

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:background="@drawable/bg_icon_circle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="30sp"/>

            </LinearLayout>

            <!-- DETAILS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <!-- USER NAME -->

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Name"
                    android:textColor="@color/darkText"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <!-- CHARGER -->

                <TextView
                    android:id="@+id/tvChargerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Fast Charger"
                    android:textColor="@color/lightText"
                    android:textSize="14sp"/>

                <!-- DATE TIME -->

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="12 July • 5 PM"
                    android:textColor="@color/lightText"
                    android:textSize="14sp"/>

                <!-- DURATION -->

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="2 Hours"
                    android:textColor="@color/lightText"
                    android:textSize="14sp"/>

            </LinearLayout>

            <!-- STATUS -->

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="PENDING"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_confirmed"/>

        </LinearLayout>

        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp"
            android:background="#EEEEEE"/>

        <!-- AMOUNT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Charging Revenue"
                android:textColor="@color/lightText"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="₹240"
                android:textColor="@color/primaryGreen"
                android:textSize="28sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ACTION BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="22dp">

            <!-- ACCEPT -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Accept"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                app:backgroundTint="@color/primaryGreen"
                app:cornerRadius="16dp"/>

            <!-- REJECT -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Reject"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#D32F2F"
                app:backgroundTint="#FFEBEE"
                app:cornerRadius="16dp"/>

        </LinearLayout>

        <!-- SCAN QR BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan Booking QR"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:backgroundTint="@color/primaryBlue"
            app:cornerRadius="16dp"/>

        <!-- COMPLETE BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Mark as Completed"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:backgroundTint="@color/primaryGreen"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>