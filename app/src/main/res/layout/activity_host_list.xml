<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp"
        android:background="@drawable/bg_home_header">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_chargers"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_chargers_desc"
            android:textColor="#E3F2FD"
            android:textSize="15sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

    <!-- CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-30dp"
        android:background="@drawable/bg_auth_card"
        android:orientation="vertical"
        android:paddingTop="18dp">

        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/available_hosts"
            android:textColor="@color/darkText"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="14dp"/>

        <!-- HOST LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:paddingBottom="18dp"
            android:clipToPadding="false"/>

    </LinearLayout>

</LinearLayout>