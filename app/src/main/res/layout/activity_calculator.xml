<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:text="@string/calculator_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            app:lottie_rawRes="@raw/charging_animation"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <!-- Battery Size -->
        <EditText
            android:id="@+id/etBattery"
            android:hint="@string/battery_size"
            android:inputType="numberDecimal"
            android:autofillHints="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Charging Time -->
        <EditText
            android:id="@+id/etTime"
            android:hint="@string/charging_time"
            android:inputType="number"
            android:autofillHints="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <!-- Calculate Button -->
        <Button
            android:id="@+id/btnCalculate"
            android:text="@string/calculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>

        <!-- Results -->
        <TextView
            android:id="@+id/tvEnergy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/energy_placeholder"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/distance_placeholder"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>